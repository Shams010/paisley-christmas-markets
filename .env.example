
SUPABASE_URL=xxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PUBLISHABLE_KEY=xxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=xxxxxxxxxxxxxxx

# Which market the site shows when a request does not name one
DEFAULT_MARKET_SLUG=paisley


